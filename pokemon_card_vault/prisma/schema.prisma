/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model assistant_user_current_pages {
  session_id String
  user_uid   String   @default("")
  path       String
  source     String   @default("assistant")
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@id([session_id, user_uid])
  @@index([session_id, updated_at(sort: Desc)], map: "assistant_user_current_pages_session_recent_idx")
  @@index([user_uid, updated_at(sort: Desc)], map: "assistant_user_current_pages_user_recent_idx", where: raw("(user_uid <> ''::text)"))
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model cards_name_type {
  name                   String
  type_key               String
  priority               Int                    @default(100)
  source                 String                 @default("manual")
  updated_at             DateTime               @default(now()) @db.Timestamptz(6)
  marketplace_card_names marketplace_card_names @relation(fields: [name], references: [name], onDelete: Cascade, onUpdate: NoAction)
  cards_type             cards_type             @relation(fields: [type_key], references: [type_key], onDelete: Cascade, onUpdate: NoAction)

  @@id([name, type_key])
  @@index([type_key, priority, name], map: "cards_name_type_type_idx")
}

model cards_type {
  type_key        String            @id
  label           String
  aliases         String[]          @default([])
  palette_key     String
  sort_order      Int               @default(1000)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  cards_name_type cards_name_type[]

  @@index([palette_key, sort_order], map: "cards_type_palette_key_idx")
}

model cardtrader_blueprint_daily_analytics {
  observed_day                  DateTime                      @db.Date
  blueprint_id                  BigInt
  listing_count                 Int                           @default(0)
  listed_quantity               Int                           @default(0)
  seller_count                  Int                           @default(0)
  sold_count                    Int                           @default(0)
  sold_quantity                 Int                           @default(0)
  min_price_pkn                 Decimal?                      @db.Decimal
  median_price_pkn              Decimal?                      @db.Decimal
  average_price_pkn             Decimal?                      @db.Decimal
  max_price_pkn                 Decimal?                      @db.Decimal
  previous_min_price_pkn        Decimal?                      @db.Decimal
  price_change_pct              Decimal?                      @db.Decimal
  sell_through_rate             Decimal                       @default(0) @db.Decimal
  source_counts                 Json                          @default("{}")
  refreshed_at                  DateTime                      @default(now()) @db.Timestamptz(6)
  cardtrader_pokemon_blueprints cardtrader_pokemon_blueprints @relation(fields: [blueprint_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([observed_day, blueprint_id])
  @@index([blueprint_id, observed_day(sort: Desc)], map: "cardtrader_blueprint_daily_analytics_blueprint_day_idx")
  @@index([observed_day(sort: Desc), sold_count(sort: Desc), listed_quantity(sort: Desc), sell_through_rate(sort: Desc)], map: "cardtrader_blueprint_daily_analytics_hot_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model cardtrader_blueprint_listing_cache {
  provider               String    @default("cardtrader")
  blueprint_id           BigInt    @id
  pokoin_card_id         String    @default("")
  cheapest_price_eur     Decimal?  @db.Decimal
  cheapest_price_pkn     Decimal?  @db.Decimal
  eligible_listing_count Int       @default(0)
  eligible_quantity      Int       @default(0)
  sample_listing_id      String    @default("")
  sample_product_id      String    @default("")
  shipping_mode          String    @default("")
  seller_country_code    String    @default("")
  source_snapshot_at     DateTime? @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @db.Timestamptz(6)

  @@index([blueprint_id], map: "cardtrader_blueprint_listing_cache_available_idx", where: raw("((eligible_quantity > 0) AND (cheapest_price_pkn IS NOT NULL))"))
  @@index([pokoin_card_id], map: "cardtrader_blueprint_listing_cache_pokoin_available_idx", where: raw("((provider = ANY (ARRAY['cardtrader'::text, 'pokoin_native'::text])) AND (pokoin_card_id <> ''::text) AND (eligible_listing_count > 0) AND (cheapest_price_pkn IS NOT NULL))"))
  @@index([provider, updated_at(sort: Desc)], map: "cardtrader_blueprint_listing_cache_provider_updated_idx")
}

