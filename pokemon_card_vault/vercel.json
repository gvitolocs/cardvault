{
  "functions": {
    "api/*.js": {
      "regions": [
        "fra1"
      ]
    }
  },
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/flutter_bootstrap.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/main.dart.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/flutter_service_worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:protected(wallet|auth|profile|checkout|orders)",
      "has": [
        {
          "type": "host",
          "value": "explorer.pokoin.com"
        }
      ],
      "destination": "https://pokoin.com/:protected",
      "permanent": true
    },
    {
      "source": "/:protected(wallet|auth|profile|checkout|orders)",
      "has": [
        {
          "type": "host",
          "value": "wallet.pokoin.com"
        }
      ],
      "destination": "https://pokoin.com/:protected",
      "permanent": true
    },
    {
      "source": "/:protected(wallet|auth|profile|checkout|orders)",
      "has": [
        {
          "type": "host",
          "value": "forum.pokoin.com"
        }
      ],
      "destination": "https://pokoin.com/:protected",
      "permanent": true
    },
    {
      "source": "/:protected(wallet|auth|profile|checkout|orders)",
      "has": [
        {
          "type": "host",
          "value": "cards.pokoin.com"
        }
      ],
      "destination": "https://pokoin.com/:protected",
      "permanent": true
    },
    {
      "source": "/:protected(wallet|auth|profile|checkout|orders)",
      "has": [
        {
          "type": "host",
          "value": "cardcaveau.pokoin.com"
        }
      ],
      "destination": "https://pokoin.com/:protected",
      "permanent": true
    },
    {
      "source": "/:protected(wallet|auth|profile|checkout|orders)",
      "has": [
        {
          "type": "host",
          "value": "www.pokoin.com"
        }
      ],
      "destination": "https://pokoin.com/:protected",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "wallet.pokoin.com"
        }
      ],
      "destination": "https://pokoin.com/wallet",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "forum.pokoin.com"
        }
      ],
      "destination": "https://pokoin.com/forum",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "cards.pokoin.com"
        }
      ],
      "destination": "https://pokoin.com/marketplace",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "cardcaveau.pokoin.com"
        }
      ],
      "destination": "https://pokoin.com/marketplace",
      "permanent": true
    },
    {
      "source": "/total-supply.txt",
      "destination": "https://rpc.pokoin.com/chain/supply/total.txt",
      "permanent": false
    },
    {
      "source": "/circulating-supply.txt",
      "destination": "https://rpc.pokoin.com/chain/supply/circulating.txt",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/pokoin-crypto.html",
      "destination": "/pokoin-crypto.html"
    },
    {
      "source": "/marketplace",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(.*bot.*|.*Bot.*|.*crawler.*|.*Crawler.*|.*spider.*|.*Spider.*|.*Google-InspectionTool.*|.*facebookexternalhit.*|.*Twitterbot.*|.*LinkedInBot.*|.*WhatsApp.*|.*Discordbot.*|.*TelegramBot.*)"
        }
      ],
      "destination": "/marketplace.html"
    },
