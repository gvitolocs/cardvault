{
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/flutter_bootstrap.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/main.dart.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/flutter_service_worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "wallet.pokoin.com"
        }
      ],
      "destination": "https://pokoin.com/wallet",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "forum.pokoin.com"
        }
      ],
      "destination": "https://pokoin.com/forum",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "cards.pokoin.com"
        }
      ],
      "destination": "https://pokoin.com/marketplace",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "cardvault.pokoin.com"
        }
      ],
      "destination": "https://pokoin.com/marketplace",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "cardcaveau.pokoin.com"
        }
      ],
      "destination": "https://pokoin.com/marketplace",
      "permanent": true
    },
    {
      "source": "/total-supply.txt",
      "destination": "https://rpc.pokoin.com/chain/supply/total.txt",
      "permanent": false
    },
    {
      "source": "/circulating-supply.txt",
      "destination": "https://rpc.pokoin.com/chain/supply/circulating.txt",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/pokoin-crypto.html",
      "destination": "/pokoin-crypto.html"
    },
    {
      "source": "/api/supply/total.txt",
      "destination": "/api/supply/total.txt"
    },
    {
      "source": "/api/supply/circulating.txt",
      "destination": "/api/supply/circulating.txt"
    },
    {
      "source": "/api/total-supply",
      "destination": "https://pokoin-status.vercel.app/api/total-supply"
    },
    {
      "source": "/api/circulating-supply",
      "destination": "https://pokoin-status.vercel.app/api/circulating-supply"
    },
    {
      "source": "/api/transfer-account-balance",
      "destination": "/api/transfer-account-balance.js"
    },
    {
      "source": "/api/request-pkn-withdraw",
      "destination": "/api/request-pkn-withdraw.js"
    },
    {
      "source": "/api/wpkn-exchange/:action",
      "destination": "/api/wpkn-exchange.js?action=:action"
    },
    {
      "source": "/api/search-recipient-emails",
      "destination": "/api/search-recipient-emails.js"
    },
    {
      "source": "/api/ensure-username",
      "destination": "/api/search-recipient-emails.js"
    },
    {
      "source": "/api/wallet-auth/nonce",
      "destination": "/api/wallet-auth-nonce.js"
    },
    {
      "source": "/api/wallet-auth/verify",
      "destination": "/api/wallet-auth-verify.js"
    },
    {
      "source": "/api/wallet-link",
      "destination": "/api/wallet-link.js"
    },
    {
      "source": "/api/create-pkn-checkout-session",
      "destination": "/api/create-pkn-checkout-session.js"
    },
    {
      "source": "/api/stripe-webhook",
      "destination": "/api/stripe-webhook.js"
    },
    {
      "source": "/api/upload-profile-picture",
      "destination": "/api/upload-profile-picture.js"
    },
    {
      "source": "/api/remove-profile-picture",
      "destination": "/api/remove-profile-picture.js"
    },
    {
      "source": "/wpkn/logo.png",
      "destination": "/pokoin-200.png"
    },
    {
      "source": "/wpkn/logo200.png",
      "destination": "/pokoin-200.png"
    },
    {
      "source": "/wpkn-reserve.json",
      "destination": "/wpkn-reserve.json"
    },
    {
      "source": "/tx/:path*",
      "destination": "/scan"
    },
    {
      "source": "/address/:path*",
      "destination": "/scan"
    },
    {
      "source": "/block/:path*",
      "destination": "/scan"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
