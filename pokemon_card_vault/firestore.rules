rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, create, update: if owns(uid);
      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && username.matches('^[a-z0-9]{3,32}$');
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username;
      allow delete: if false;
    }

    match /wallet_addresses/{address} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.address == address
        && request.resource.data.email is string;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.address == address;
      allow delete: if false;
    }

    match /email_wallets/{email} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == email
        && request.resource.data.address is string
        && request.resource.data.address.matches('^0x[a-f0-9]{40}$');
      allow delete: if false;
    }

    match /balances/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.availablePkn == 0
        && request.resource.data.lockedPkn == 0;
      allow update, delete: if false;
    }

    match /ledger_entries/{entryId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /wallet_activity/{entryId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.detail is string
        && request.resource.data.kind in ['inbound', 'outbound'];
      allow update, delete: if false;
    }

    match /pkn_purchases/{purchaseId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid
          || request.auth.uid in resource.data.sellerUids);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /card_listings/{listingId} {
      allow read: if resource.data.status == 'active'
        || (signedIn() && resource.data.sellerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.cardId is string
        && request.resource.data.cardId.size() > 0
        && request.resource.data.sellerName is string
        && request.resource.data.sellerName.size() > 0
        && request.resource.data.pricePkn is number
        && request.resource.data.pricePkn > 0
        && request.resource.data.quantityAvailable is int
        && request.resource.data.quantityAvailable > 0
        && request.resource.data.quantityAvailable <= 99
        && request.resource.data.condition in ['NM', 'SP', 'MP', 'PL', 'Poor']
        && request.resource.data.language in ['EN', 'IT', 'FR', 'DE', 'ES', 'JP']
        && request.resource.data.status == 'active'
        && request.resource.data.reverse is bool
        && request.resource.data.graded is bool
        && (!request.resource.data.graded
          || (request.resource.data.gradingCompany is string
            && request.resource.data.gradingCompany.size() > 0
            && request.resource.data.grade is string
            && request.resource.data.grade.size() > 0
            && request.resource.data.certificationId is string
            && request.resource.data.certificationId.size() > 0))
        && request.resource.data.shippingAvailable is bool
        && request.resource.data.nftAvailable is bool;
      allow update: if signedIn()
        && resource.data.sellerUid == request.auth.uid
        && request.resource.data.sellerUid == resource.data.sellerUid
        && request.resource.data.cardId == resource.data.cardId
        && request.resource.data.pricePkn is number
        && request.resource.data.pricePkn > 0
        && request.resource.data.quantityAvailable is int
        && request.resource.data.quantityAvailable >= 0
        && request.resource.data.quantityAvailable <= 99
        && request.resource.data.condition in ['NM', 'SP', 'MP', 'PL', 'Poor']
        && request.resource.data.language in ['EN', 'IT', 'FR', 'DE', 'ES', 'JP']
        && request.resource.data.reverse is bool
        && request.resource.data.graded is bool
        && (!request.resource.data.graded
          || (request.resource.data.gradingCompany is string
            && request.resource.data.gradingCompany.size() > 0
            && request.resource.data.grade is string
            && request.resource.data.grade.size() > 0
            && request.resource.data.certificationId is string
            && request.resource.data.certificationId.size() > 0))
        && request.resource.data.status in ['active', 'inactive', 'sold_out'];
      allow delete: if false;
    }

    match /user_carts/{uid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 100;
      allow delete: if owns(uid);
    }

    match /user_card_watchlists/{uid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.cardIds is list
        && request.resource.data.cardIds.size() <= 1000
        && request.resource.data.expiresAt is timestamp;
      allow delete: if owns(uid);
    }

    match /user_card_recent_views/{uid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.cardIds is list
        && request.resource.data.cardIds.size() <= 60
        && request.resource.data.cards is list
        && request.resource.data.cards.size() <= 60
        && request.resource.data.expiresAt is timestamp;
      allow delete: if owns(uid);
    }

    match /withdraw_requests/{requestId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amountPkn is int
        && request.resource.data.amountPkn > 0
        && request.resource.data.toAddress is string
        && request.resource.data.toAddress.matches('^0x[a-fA-F0-9]{40}$');
      allow update, delete: if false;
    }

    match /forum_categories/{categoryId} {
      allow read: if true;
      allow create: if signedIn()
        && categoryId in ['general', 'cards', 'pkn', 'validators']
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.iconName is string
        && request.resource.data.order is int
        && request.resource.data.topicCount == 1
        && request.resource.data.postCount == 1;
      allow update: if signedIn()
        && resource.id in ['general', 'cards', 'pkn', 'validators']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['topicCount', 'postCount', 'updatedAt'])
        && request.resource.data.topicCount >= resource.data.topicCount
        && request.resource.data.postCount >= resource.data.postCount;
      allow delete: if false;
    }

    match /forum_topics/{topicId} {
      allow read: if resource.data.status == 'open';
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.categoryId in ['general', 'cards', 'pkn', 'validators']
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 6
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 12
        && request.resource.data.body.size() <= 5000
        && request.resource.data.replyCount == 0
        && request.resource.data.status == 'open';
      allow update: if signedIn()
        && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['replyCount', 'updatedAt'])
        && request.resource.data.replyCount == resource.data.replyCount + 1;
      allow delete: if false;
    }

    match /forum_posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.topicId is string
        && request.resource.data.categoryId in ['general', 'cards', 'pkn', 'validators']
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 3
        && request.resource.data.body.size() <= 5000;
      allow update, delete: if false;
    }
  }
}
